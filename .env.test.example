# Copy to .env.test.local (gitignored) to run the e2e suite locally.
# These are dedicated test accounts in the dev Supabase project, not real
# user credentials — never put real client data or production credentials
# in this file regardless.

E2E_BASE_URL=http://localhost:3000

# A trainer-role account (profiles.role = 'trainer')
E2E_TRAINER_EMAIL=
E2E_TRAINER_PASSWORD=

# A client-role account already linked to a clients row
# (clients.auth_user_id = this user's id)
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
